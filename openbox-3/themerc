# Menu
menu.border.color: #31193a

menu.title.bg: Solid Flat
menu.title.bg.color: #5a4063
menu.title.bg.shadow: 0
menu.title.text.color: #ed981a
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #5a4063
menu.items.text.color: #ed981a
menu.items.disabled.text.color: #c8822c

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #55cfca
menu.items.active.text.color: #ed981a

menu.separator.color: #c8822c
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #5a4063

# Active window
window.active.border.color: #55cfca


window.active.title.bg: flat solid
window.active.title.bg.color: #5a4063
window.active.title.separator.color: #5a4063
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #ed981a

window.active.handle.bg: flat solid
window.active.handle.bg.color: #5a4063

window.active.grip.bg: flat solid
window.active.grip.bg.color: #5a4063

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #5a4063
window.active.button.unpressed.image.color: #ed981a

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #55cfca
window.active.button.pressed.image.color: #c74ec7

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #5a4063
window.active.button.disabled.image.color: #c8822c

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #5a4063
window.active.button.hover.image.color: #55cfca

#window.active.button.toggled.bg: #55cfca
#window.active.button.toggled.image.color: #c74ec7

# Inactive window
window.inactive.border.color: #ed981a

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #5a4063
window.inactive.title.separator.color: #5a4063
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #c8822c

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #5a4063

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #5a4063

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #5a4063
window.inactive.button.unpressed.image.color: #c8822c

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #55cfca
window.inactive.button.pressed.image.color: #c74ec7

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #c8822c
window.inactive.button.disabled.image.color: #5a4063

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #5a4063
window.inactive.button.hover.image.color: #55cfca


# OSD
osd.border.width: 1
osd.border.color: #55cfca

osd.bg: flat solid
osd.bg.color: #5a4063
osd.label.bg: flat solid
osd.label.bg.color: #5a4063
osd.label.text.color: #ed981a

# OSD
osd.bg: Solid Flat
osd.bg.color: #5a4063
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #55cfca
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #55cfca

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #ed981a
#osd.button.unpressed.*.border.color: #f2be4e

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #55cfca
#osd.button.pressed.*.border.color: #c74ec7

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #31193a
#osd.button.focused.*.border.color: #55cfca

osd.button.focused.box.color: #55cfca


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
